def act_excl_show(for_mode: str | None = None) -> None:
    args = ["site-exclusions", "show"]
    if for_mode:
        args += ["--for-mode", for_mode]
    _, out, error = run(args, timeout=30)
    output_text = out or error
    head("Исключения сайтов")
    _, mode_out, _ = run(["site-exclusions", "mode"], timeout=20)
    if mode_out:
        kv("Режим", mode_out.replace("Current exclusion mode is", "").strip(), 10)
    items = [l.strip() for l in output_text.splitlines()[1:] if l.strip()]
    if items:
        for item in items:
            print(f"  · {item}")
    else:
        say(f"  {C.GREY}{text('list is empty', 'список пуст')}{C.RESET}")
    say(f"\n  {C.GREY}" + text("general — VPN everywhere except listed sites; selective — VPN only for listed sites", "general — VPN везде, кроме списка; selective — VPN только для списка") + f"{C.RESET}\n")


def act_excl_add(domains: list[str], for_mode: str | None = None) -> bool:
    if not domains:
        err("укажите хотя бы один домен")
        return False
    args = ["site-exclusions", "add", *domains]
    if for_mode:
        args += ["--for-mode", for_mode]
    return cli(args, timeout=30)[0]


def act_excl_remove(domains: list[str], for_mode: str | None = None) -> bool:
    if not domains:
        err("укажите хотя бы один домен")
        return False
    args = ["site-exclusions", "remove", *domains]
    if for_mode:
        args += ["--for-mode", for_mode]
    return cli(args, timeout=30)[0]


def act_excl_clear(for_mode: str | None = None, assume_yes: bool = False) -> bool:
    if not assume_yes and not confirm("Очистить все исключения?"):
        return False
    args = ["site-exclusions", "clear"]
    if for_mode:
        args += ["--for-mode", for_mode]
    return cli(args, timeout=30)[0]


def act_excl_mode(value: str | None = None) -> bool:
    args = ["site-exclusions", "mode"]
    if value:
        v = value.lower()
        if v not in ("general", "selective"):
            err("режим: general или selective")
            return False
        args.append(v)
    return cli(args, timeout=30)[0]


# --------------------------------------------------------------------------
# избранное и профили
# --------------------------------------------------------------------------


def act_fav_add(names: list[str]) -> None:
    state = load_state()
    favs = state.setdefault("favorites", [])
    for name in names:
        if name and name.lower() not in {f.lower() for f in favs}:
            favs.append(name)
            ok(text("added to favorites: {name}", "в избранное: {name}").format(name=name))
        else:
            warn(text("already in favorites: {name}", "уже в избранном: {name}").format(name=name))
    save_state(state)


def act_fav_remove(names: list[str]) -> None:
    state = load_state()
    favs = state.setdefault("favorites", [])
    lower = {n.lower() for n in names}
    kept = [f for f in favs if f.lower() not in lower]
    removed = len(favs) - len(kept)
    state["favorites"] = kept
    save_state(state)
    ok(text("removed from favorites: {count}", "удалено из избранного: {count}").format(count=removed)) if removed else warn("ничего не удалено")


def act_fav_list() -> None:
    state = load_state()
    head("Избранные локации")
    favs = state.get("favorites", [])
    if favs:
        for i, f in enumerate(favs, 1):
            print(f"  {i:>2}. {C.YELLOW}★{C.RESET} {f}")
    else:
        say(f"  {C.GREY}{text('empty — add', 'пусто — добавьте')}: {APP} fav add Riga{C.RESET}")
    hist = state.get("history", [])
    if hist:
        say(f"\n  {C.GREY}{text('Recent', 'Недавние')}: {', '.join(hist[:5])}{C.RESET}")
    say()


PROFILE_KEYS = ("mode", "dns", "socks-port", "socks-host", "routing", "protocol",
                "post-quantum", "system-dns", "notifications")


def act_profile_save(name: str) -> None:
    cfg = get_config()
    if not cfg:
        err(text("could not read current configuration; profile was not saved", "не удалось прочитать текущую конфигурацию; профиль не сохранён"))
        return
    snapshot = {
        "mode": cfg.get("Mode", ""),
        "dns": cfg.get("DNS upstream", ""),
        "socks-port": cfg.get("SOCKS port", ""),
        "socks-host": cfg.get("SOCKS host", ""),
        "routing": cfg.get("Tunnel routing mode", ""),
        "protocol": cfg.get("Protocol", ""),
        "post-quantum": cfg.get("Post-quantum cryptography", ""),
        "system-dns": cfg.get("Change system DNS", ""),
        "notifications": cfg.get("Show notifications", ""),
    }
    state = load_state()
    state.setdefault("profiles", {})[name] = snapshot
    save_state(state)
    ok(text("profile «{name}» saved", "профиль «{name}» сохранён").format(name=name))


def _clean(value: str) -> str:
    """Нормализовать значение из config show ('Default (auto)' -> 'auto')."""
    v = (value or "").strip()
    m = re.match(r"^Default \((.+)\)$", v)
    if m:
        v = m.group(1)
    if v.lower().startswith("default"):
        return "default"
    return v.strip()


def act_profile_apply(name: str) -> bool:
    state = load_state()
    prof = state.get("profiles", {}).get(name)
    if not prof:
        err(text("profile «{name}» not found", "профиль «{name}» не найден").format(name=name))
        return False
    if not get_config():
        err(text("could not read current configuration; profile was not applied", "не удалось прочитать текущую конфигурацию; профиль не применён"))
        return False
    head(text("Applying profile «{name}»", "Применяю профиль «{name}»").format(name=name))
    applied = 0
    failed = 0
    for key in PROFILE_KEYS:
        raw = _clean(prof.get(key, ""))
        if not raw:
            continue
        if key == "dns" and raw.lower() in ("default", "default (provided by adguard vpn)"):
            raw = "default"
        if key in ("post-quantum", "system-dns", "notifications"):
            raw = "on" if raw.lower().startswith("on") else "off"
        if key == "mode":
            raw = raw.lower()
        if act_set(key, raw):
            applied += 1
        else:
            failed += 1
    if failed:
        warn(text("settings applied: {ok}, failed: {failed}", "применено настроек: {ok}, ошибок: {failed}").format(ok=applied, failed=failed))
        return False
    ok(text("settings applied: {count}", "применено настроек: {count}").format(count=applied))
    return True


def act_profile_list() -> None:
    state = load_state()
    head("Профили настроек")
    profiles = state.get("profiles", {})
    if not profiles:
        say(f"  {C.GREY}{text('empty — save current settings', 'пусто — сохраните текущие настройки')}: {APP} profile save work{C.RESET}\n")
        return
    for name, prof in profiles.items():
        print(f"  {C.B}{name}{C.RESET}")
        for key, value in prof.items():
            if value:
                print(f"    {C.GREY}{key:<14}{C.RESET} {value}")
    say()


def act_profile_delete(name: str) -> None:
    state = load_state()
    if state.get("profiles", {}).pop(name, None) is None:
        err(text("profile «{name}» not found", "профиль «{name}» не найден").format(name=name))
        return
    save_state(state)
    ok(text("profile «{name}» deleted", "профиль «{name}» удалён").format(name=name))

# --------------------------------------------------------------------------
# интерактивное меню
# --------------------------------------------------------------------------


def ask(prompt: str, default: str = "") -> str:
    suffix = f" {C.GREY}[{default}]{C.RESET}" if default else ""
    try:
        answer = input(f"{C.CYAN}?{C.RESET} {translate(prompt)}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        raise SystemExit(130)
    return answer or default


def confirm(prompt: str, default: bool = False) -> bool:
    hint = "Y/n" if default else "y/N"
    try:
        answer = input(f"{C.YELLOW}?{C.RESET} {translate(prompt)} {C.GREY}[{hint}]{C.RESET}: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        say()
        return False
    if not answer:
        return default
    return answer in ("y", "yes", "д", "да")


def pause() -> None:
    try:
        input(f"\n{C.GREY}{text('Enter — continue…', 'Enter — продолжить…')}{C.RESET}")
    except (EOFError, KeyboardInterrupt):
        say()


def clear_screen() -> None:
    if sys.stdout.isatty():
        print("\033[H\033[2J", end="")


def pick_location() -> str | None:
    """Выбрать локацию: избранное, поиск, номер из списка."""
    state = load_state()
    favs = state.get("favorites", [])
    hist = state.get("history", [])

    head("Выбор локации")
    shortcuts: list[str] = []
    if favs:
        say(f"  {C.B}{text('Favorites', 'Избранное')}{C.RESET}")
        for f in favs:
            shortcuts.append(f)
            print(f"  {len(shortcuts):>3}. {C.YELLOW}★{C.RESET} {f}")
    if hist:
        say(f"  {C.B}{text('Recent', 'Недавние')}{C.RESET}")
        for h in hist[:5]:
            if h.lower() in {s.lower() for s in shortcuts}:
                continue
            shortcuts.append(h)
            print(f"  {len(shortcuts):>3}. {C.GREY}⟲{C.RESET} {h}")

    say(f"\n  {C.GREY}" + text("Enter a number, city/country/ISO,", "Введите номер, название города/страны/ISO,"))
    say("  " + text("«l» — full list, «f» — fastest, empty — cancel", "«l» — весь список, «f» — самая быстрая, пусто — отмена") + f"{C.RESET}\n")

    answer = ask("Локация")
    if not answer:
        return None
    if answer.lower() == "f":
        return "__FASTEST__"
    if answer.lower() == "l":
        rows = show_locations()
        if not rows:
            return None
        choice = ask("Номер локации")
        if choice.isdigit() and 1 <= int(choice) <= len(rows):
            return rows[int(choice) - 1]["city"]
        return choice or None
    if answer.isdigit():
        idx = int(answer)
        if 1 <= idx <= len(shortcuts):
            return shortcuts[idx - 1]
        warn("нет такого номера")
        return None
    return answer


def menu_connect() -> None:
    target = pick_location()
    if not target:
        return
    if target == "__FASTEST__":
        act_connect(fastest=True)
    else:
        act_connect(location=target)


def menu_settings() -> None:
    while True:
        clear_screen()
        show_config()
        options = [
            ("режим TUN/SOCKS", "TUN/SOCKS mode"), ("DNS upstream", "DNS upstream"),
            ("SOCKS порт/хост", "SOCKS port/host"), ("маршрутизация TUN", "TUN routing"),
            ("канал обновлений", "update channel"), ("протокол (auto/http2/quic)", "protocol (auto/http2/quic)"),
            ("постквантовое шифрование", "post-quantum encryption"), ("системный DNS вкл/выкл", "system DNS on/off"),
            ("уведомления вкл/выкл", "notifications on/off"), ("отладочный лог вкл/выкл", "debug log on/off"),
            ("скрипт маршрутизации", "routing script"), ("сбросить SOCKS-логин/пароль", "clear SOCKS username/password"),
            ("телеметрия и отчёты о сбоях", "telemetry and crash reports"),
        ]
        for number, (ru, en) in enumerate(options, 1):
            say(f"  {C.B}{number}{C.RESET} {text(en, ru)}")
        say(f"\n  {C.B}0{C.RESET} {tr('back')}")
        choice = ask("Выбор")

        if choice in ("0", ""):
            return
        if choice == "1":
            act_set("mode", ask("Режим (tun/socks)", "tun"))
        elif choice == "2":
            say(f"  {C.GREY}{text('examples', 'примеры')}: default, 94.140.14.14, tls://dns.adguard-dns.com{C.RESET}")
            act_set("dns", ask("DNS upstream", "default"))
        elif choice == "3":
            act_set("socks-port", ask("SOCKS порт", "1080"))
            host = ask("SOCKS хост (пусто — не менять)", "")
            if host:
                act_set("socks-host", host)
                if host not in ("127.0.0.1", "localhost"):
                    warn("для нелокального хоста нужны логин и пароль")
                    user = ask("SOCKS логин")
                    if user:
                        act_set("socks-user", user)
                        import getpass
                        try:
                            pwd = getpass.getpass(f"{C.CYAN}?{C.RESET} {translate('SOCKS пароль')}: ")
                        except (EOFError, KeyboardInterrupt):
                            raise SystemExit(130)
                        if pwd:
                            act_set("socks-pass", pwd)
        elif choice == "4":
            act_set("routing", ask("Маршрутизация (auto/script/none)", "auto"))
        elif choice == "5":
            act_set("channel", ask("Канал (release/beta/nightly)", "release"))
        elif choice == "6":
            act_set("protocol", ask("Протокол (auto/http2/quic)", "auto"))
        elif choice == "7":
            act_set("post-quantum", ask("Постквантовое шифрование (on/off)", "on"))
        elif choice == "8":
            act_set("system-dns", ask("Менять системный DNS (on/off)", "on"))
        elif choice == "9":
            act_set("notifications", ask("Уведомления (on/off)", "off"))
        elif choice == "10":
            act_set("debug", ask("Отладочный лог (on/off)", "off"))
        elif choice == "11":
            act_route_script()
        elif choice == "12":
            act_socks_clear_auth()
        elif choice == "13":
            act_set("telemetry", ask("Телеметрия (on/off)", "off"))
            act_set("crash-reports", ask("Отчёты о сбоях (on/off)", "off"))
        else:
            warn("неизвестный пункт")
        pause()


def menu_exclusions() -> None:
    while True:
        clear_screen()
        act_excl_show()
        say(f"  {C.B}1{C.RESET} {text('add domains', 'добавить домены')}      {C.B}4{C.RESET} {text('change mode (general/selective)', 'сменить режим (general/selective)')}")
        say(f"  {C.B}2{C.RESET} {text('remove domains', 'удалить домены')}       {C.B}5{C.RESET} {text('show another mode list', 'показать список другого режима')}")
        say(f"  {C.B}3{C.RESET} {text('clear list', 'очистить список')}")
        say(f"\n  {C.B}0{C.RESET} {tr('back')}")
        choice = ask("Выбор")
        if choice in ("0", ""):
            return
        if choice == "1":
            raw = ask("Домены через пробел (например: bank.ru *.gov.ru)")
            if raw:
                act_excl_add(raw.split())
        elif choice == "2":
            raw = ask("Домены через пробел")
            if raw:
                act_excl_remove(raw.split())
        elif choice == "3":
            act_excl_clear()
        elif choice == "4":
            act_excl_mode(ask("Режим (general/selective)", "general"))
        elif choice == "5":
            act_excl_show(ask("Показать режим (general/selective)", "selective"))
        else:
            warn("неизвестный пункт")
        pause()



#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
agvpn - удобная консольная оболочка над AdGuard VPN CLI.

Возможности:
  * интерактивное меню (без аргументов) и полноценный CLI
  * быстрое подключение, избранные локации, поиск по локациям с пингом
  * читаемый статус: локация, режим, интерфейс, IP, трафик, время сессии
  * управление настройками (режим, DNS, SOCKS, протокол, маршрутизация и пр.)
  * исключения сайтов (general/selective), профили настроек
  * kill switch-проверка утечек DNS/IP, watch-мониторинг, логи

Требует установленный adguardvpn-cli.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

APP = "agvpn"
VERSION = "2.0.0"

BIN = os.environ.get("AGVPN_BIN") or shutil.which("adguardvpn-cli") or "adguardvpn-cli"
DATA_DIR = Path.home() / ".local" / "share" / "adguardvpn-cli"
CONF_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP
STATE = CONF_DIR / "state.json"

ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
NO_COLOR = bool(os.environ.get("NO_COLOR")) or not sys.stdout.isatty()


class C:
    """ANSI-цвета с автоотключением при отсутствии TTY."""

    RESET = "" if NO_COLOR else "\033[0m"
    B = "" if NO_COLOR else "\033[1m"
    DIM = "" if NO_COLOR else "\033[2m"
    RED = "" if NO_COLOR else "\033[31m"
    GREEN = "" if NO_COLOR else "\033[32m"
    YELLOW = "" if NO_COLOR else "\033[33m"
    BLUE = "" if NO_COLOR else "\033[34m"
    MAGENTA = "" if NO_COLOR else "\033[35m"
    CYAN = "" if NO_COLOR else "\033[36m"
    GREY = "" if NO_COLOR else "\033[90m"


def strip_ansi(text: str) -> str:
    return ANSI.sub("", text or "")


def say(msg: str = "") -> None:
    print(translate(msg))


def ok(msg: str) -> None:
    print(f"{C.GREEN}✔{C.RESET} {translate(msg)}")


def warn(msg: str) -> None:
    print(f"{C.YELLOW}!{C.RESET} {translate(msg)}")


def err(msg: str) -> None:
    print(f"{C.RED}✖{C.RESET} {translate(msg)}", file=sys.stderr)


def info(msg: str) -> None:
    print(f"{C.CYAN}·{C.RESET} {translate(msg)}")


def head(title: str) -> None:
    title = translate(title)
    line = "─" * max(len(title) + 2, 34)
    print(f"\n{C.B}{C.BLUE}{title}{C.RESET}\n{C.GREY}{line}{C.RESET}")



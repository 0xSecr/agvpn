        say(f"  {C.B}2{C.RESET} {text('traffic monitor (watch)', 'мониторинг трафика (watch)')}  {C.B}6{C.RESET} {text('update program', 'обновить программу')}")
        say(f"  {C.B}3{C.RESET} {text('application log', 'лог приложения')}              {C.B}7{C.RESET} {text('export logs to ZIP', 'экспорт логов в zip')}")
        say(f"  {C.B}4{C.RESET} {text('tunnel log', 'лог туннеля')}                 {C.B}8{C.RESET} {text('license and account', 'лицензия и аккаунт')}")
        say(f"\n  {C.B}0{C.RESET} {tr('back')}")
        choice = ask("Выбор")

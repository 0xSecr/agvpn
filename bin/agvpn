def translate(message: str) -> str:
    return EN_MESSAGES.get(message, message) if LANG == "en" else message


def text(en: str, ru: str) -> str:
    """Select a message template before formatting user-provided values."""
    return ru if LANG == "ru" else en


def load_state() -> dict:
    try:
        data = json.loads(STATE.read_text(encoding="utf-8"))
        merged = dict(DEFAULT_STATE)
        merged.update({k: v for k, v in data.items() if k in DEFAULT_STATE})
        if not isinstance(merged.get("favorites"), list):
            merged["favorites"] = []
        if not isinstance(merged.get("profiles"), dict):
            merged["profiles"] = {}
        if not isinstance(merged.get("history"), list):
            merged["history"] = []
        if merged.get("language") not in TRANSLATIONS:
            merged["language"] = "en"
        return merged
    except Exception:
        return dict(DEFAULT_STATE)


def save_state(state: dict) -> None:
    try:
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
    except OSError as exc:
        warn(text("could not save state: {error}", "не удалось сохранить состояние: {error}").format(error=exc))


def load_language() -> None:
    global LANG
    value = load_state().get("language", "en")
    LANG = value if value in TRANSLATIONS else "en"


def set_language(value: str) -> None:
    global LANG
    LANG = "ru" if value.lower() in ("ru", "russian", "русский", "2") else "en"
    state = load_state()
    state["language"] = LANG
    save_state(state)
    ok("Язык изменён на русский" if LANG == "ru" else "Language set to English")


def remember(location: str) -> None:
    state = load_state()
    hist = [h for h in state.get("history", []) if h != location]
    hist.insert(0, location)
    state["history"] = hist[:10]
    save_state(state)

# --------------------------------------------------------------------------
# вызовы adguardvpn-cli
# --------------------------------------------------------------------------


def have_cli() -> bool:
    return shutil.which(BIN) is not None or Path(BIN).exists()


def run(args: list[str], timeout: int = 90) -> tuple[int, str, str]:
    """Запустить adguardvpn-cli и вернуть (код, stdout, stderr) без ANSI."""
    try:
        proc = subprocess.run(
            [BIN, *args],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return proc.returncode, strip_ansi(proc.stdout).strip(), strip_ansi(proc.stderr).strip()
    except FileNotFoundError:
        err(text("adguardvpn-cli not found (looked for: {bin})", "не найден adguardvpn-cli (искал: {bin})").format(bin=BIN))
        say(translate("Установка:") + " curl -fsSL https://raw.githubusercontent.com/AdguardTeam/AdguardVPNCLI/HEAD/scripts/release/install.sh | sh -s -- -v")
        sys.exit(127)
    except subprocess.TimeoutExpired:
        return 124, "", text("command timed out ({timeout}s)", "таймаут выполнения ({timeout}s)").format(timeout=timeout)


def run_live(args: list[str]) -> int:
    """Запустить с прямым выводом в терминал (для login/update/connect -v)."""
    try:
        return subprocess.call([BIN, *args])
    except FileNotFoundError:
        err(text("adguardvpn-cli not found (looked for: {bin})", "не найден adguardvpn-cli (искал: {bin})").format(bin=BIN))
        return 127
    except KeyboardInterrupt:
        return 130


def cli(args: list[str], quiet: bool = False, timeout: int = 90) -> tuple[bool, str]:
    """Обёртка: печатает первую значимую строку вывода, возвращает (успех, текст)."""
    code, out, error = run(args, timeout=timeout)
    output_text = out or error
    low = output_text.lower()

    # Настройка записана, но не применилась к активному туннелю.
    # adguardvpn-cli отдаёт ненулевой код — для нас это успех + подсказка.
    if code != 0 and "config has been updated" in low:
        if not quiet:
            ok(text("setting saved", "настройка сохранена"))
            if "active connection" in low:
                warn(text("reconnect to apply: {app} r", "чтобы применить, переподключитесь: {app} r").format(app=APP))
        return True, output_text

    if code == 0:
        if not quiet and output_text:
            for line in output_text.splitlines():
                if line.strip():
                    ok(line.strip())
                    break
        return True, output_text
    if not quiet:
        err(output_text or text("command failed with code {code}", "команда завершилась с кодом {code}").format(code=code))
    return False, output_text


# --------------------------------------------------------------------------
# разбор статуса / конфигурации / локаций
# --------------------------------------------------------------------------


def status_raw() -> str:
    _, out, error = run(["status"], timeout=20)
    return out or error


def parse_status(text: str) -> dict:
    """Разобрать вывод status в структуру."""
    st = {
        "connected": False,
        "location": None,
        "mode": None,
        "iface": None,
        "warnings": [],
        "raw": text,
    }
    low = text.lower()
    if re.search(r"(?<!not )connected to", low) and "not connected" not in low:
        st["connected"] = True
        m = re.search(r"Connected to\s+(.+?)\s+in\s+(\S+)\s+mode", text, re.I)
        if m:
            st["location"] = m.group(1).strip()
            st["mode"] = m.group(2).strip().upper()
        m = re.search(r"running on\s+(\S+)", text, re.I)
        if m:
            st["iface"] = m.group(1).strip().rstrip(".")
        if st["mode"] is None and "socks" in low:
            st["mode"] = "SOCKS"
    for line in text.splitlines():
        s = line.strip()
        if s.lower().startswith("warning"):
            st["warnings"].append(s)
    return st


def get_config() -> dict:
    """config show -> словарь ключ/значение."""
    _, out, error = run(["config", "show"], timeout=30)
    cfg: dict[str, str] = {}
    for line in (out or error).splitlines():
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        key = key.strip().lstrip("\t ")
        if not key or key.lower().startswith("current configuration"):
            continue
        cfg[key] = value.strip()
    return cfg


def get_locations(count: int | None = None) -> list[dict]:
    """Список локаций: [{iso, country, city, ping}]."""
    args = ["list-locations"]
    if count:
        args.append(str(count))
    _, out, error = run(args, timeout=60)
    rows: list[dict] = []
    for line in (out or error).splitlines():
        line = line.rstrip()
        if not line.strip() or line.strip().upper().startswith("ISO"):
            continue
        m = re.match(r"^([A-Z]{2})\s{2,}(.+?)\s{2,}(.+?)\s{2,}(\d+)\s*$", line)
        if m:
            rows.append(
                {
                    "iso": m.group(1),
                    "country": m.group(2).strip(),
                    "city": m.group(3).strip(),
                    "ping": int(m.group(4)),
                }
            )
            continue
        m = re.match(r"^([A-Z]{2})\s{2,}(.+?)\s{2,}(.+?)\s*$", line)
        if m:
            rows.append(
                {
                    "iso": m.group(1),
                    "country": m.group(2).strip(),
                    "city": m.group(3).strip(),
                    "ping": None,
                }
            )
    return rows


def license_info() -> tuple[int, str]:
    code, out, error = run(["license"], timeout=30)
    return code, out or error


def is_logged_in() -> bool:
    """Проверить, выполнен ли вход в аккаунт AdGuard VPN."""
    code, raw_info = license_info()
    if code != 0 or not raw_info:
        return False
    info_text = raw_info.lower()
    logged_out_markers = ("not logged in", "нужно войти", "не выполнен вход", "logged out")
    if any(marker in info_text for marker in logged_out_markers):
        return False
    return "logged in as" in info_text or "выполнен вход" in info_text or ("account" in info_text and "@" in info_text)


def require_login() -> bool:
    """Не запускать рабочие функции без авторизации в AdGuard VPN."""
    if is_logged_in():
        return True
    head(text("AdGuard account login required", "Требуется вход в аккаунт AdGuard"))
    warn(text("You are not logged in to AdGuard VPN.", "Вы не вошли в аккаунт AdGuard VPN."))
    say(text("To continue, run:", "Для продолжения выполните:"))
    say("  adguardvpn-cli login")
    say(text("Follow the instructions in the terminal or browser, then run agvpn again.",
             "Следуйте инструкции в терминале или браузере, затем снова запустите agvpn."))
    say(text("To log out later, run:", "Чтобы выйти из аккаунта, выполните:"))
    say("  agvpn logout")
    return False


def iface_traffic(iface: str | None) -> tuple[int, int] | None:
    """Счётчики rx/tx байт для интерфейса."""
    if not iface:
        return None
    base = Path("/sys/class/net") / iface / "statistics"
    try:
        return (
            int((base / "rx_bytes").read_text().strip()),
            int((base / "tx_bytes").read_text().strip()),
        )
    except (OSError, ValueError):
        return None


def human_bytes(num: int | float) -> str:
    step = 1024.0
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(num) < step:
            return f"{num:.0f} {unit}" if unit == "B" else f"{num:.2f} {unit}"
        num /= step
    return f"{num:.2f} PiB"


def session_uptime() -> str | None:
    """Время работы VPN-сервиса по pid-файлу."""
    pid_file = DATA_DIR / "vpn.pid"
    try:
        pid = int(pid_file.read_text().strip())
        started = Path(f"/proc/{pid}").stat().st_ctime
        delta = timedelta(seconds=int(time.time() - started))
        return str(delta)
    except (OSError, ValueError):
        return None

# --------------------------------------------------------------------------
# сеть: внешний IP, DNS-утечки
# --------------------------------------------------------------------------


def external_ip(timeout: int = 6) -> dict | None:
    """Внешний IP через публичные сервисы (только по явному запросу пользователя)."""
    endpoints = [
        ("https://ipinfo.io/json", ("ip", "country", "city", "org")),
        ("https://api.ipify.org?format=json", ("ip",)),
    ]
    import urllib.request

    for url, fields in endpoints:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": f"{APP}/{VERSION}"})
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read().decode("utf-8", "replace"))
            return {k: data.get(k) for k in fields if data.get(k)}
        except Exception:
            continue
    return None


def system_dns() -> list[str]:
    servers: list[str] = []
    try:
        for line in Path("/etc/resolv.conf").read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("nameserver"):
                parts = line.split()
                if len(parts) > 1:
                    servers.append(parts[1])
    except OSError:
        pass
    return servers


def vpn_dns() -> list[str]:
    servers: list[str] = []
    try:
        for line in (DATA_DIR / "resolv.conf").read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("nameserver"):
                parts = line.split()
                if len(parts) > 1:
                    servers.append(parts[1])
    except OSError:
        pass
    return servers


# --------------------------------------------------------------------------
# вывод: статус, конфиг, локации
# --------------------------------------------------------------------------


def kv(key: str, value: str, width: int = 20) -> None:
    print(f"  {C.GREY}{translate(key).ljust(width)}{C.RESET} {value}")


def show_status(check_ip: bool = False, brief: bool = False) -> dict:
    st = parse_status(status_raw())

    if brief:
        if st["connected"]:
            print(f"{C.GREEN}●{C.RESET} {st['location'] or '?'} [{st['mode'] or '?'}]")
        else:
            print(f"{C.RED}○{C.RESET} {tr('disconnected')}")
        return st

    head("Статус AdGuard VPN")
    if st["connected"]:
        kv("Состояние", f"{C.GREEN}{C.B}{tr('connected')}{C.RESET}")
        kv("Локация", f"{C.B}{st['location'] or '—'}{C.RESET}")
        kv("Режим", st["mode"] or "—")
        if st["iface"]:
            kv("Интерфейс", st["iface"])
        up = session_uptime()
        if up:
            kv("Время сессии", up)
        traffic = iface_traffic(st["iface"])
        if traffic:
            kv("Трафик", f"↓ {human_bytes(traffic[0])}  ↑ {human_bytes(traffic[1])}")
    else:
        kv("Состояние", f"{C.RED}{tr('disconnected')}{C.RESET}")

    cfg = get_config()
    if cfg.get("Mode"):
        kv("Режим в настройках", cfg["Mode"])
    if cfg.get("Mode", "").lower() == "socks":
        kv("SOCKS", f"{cfg.get('SOCKS host', '?')}:{cfg.get('SOCKS port', '?')}")
    if cfg.get("DNS upstream"):
        kv("DNS upstream", cfg["DNS upstream"])

    _, lic = license_info()
    for line in lic.splitlines():
        low = line.lower()
        if "logged in as" in low:
            kv("Аккаунт", line.split("as", 1)[-1].strip())
        elif "you are using" in low:
            kv("Подписка", line.replace("You are using the", "").replace("version", "").strip())
        elif "valid until" in low:
            kv("Действует до", line.split("until", 1)[-1].strip())

    for w in st["warnings"]:
        warn(w)

    if check_ip:
        info("запрашиваю внешний IP…")
        data = external_ip()
        if data:
            place = ", ".join(x for x in (data.get("city"), data.get("country")) if x)
            kv("Внешний IP", f"{C.B}{data.get('ip', '?')}{C.RESET}" + (f"  ({place})" if place else ""))
            if data.get("org"):
                kv("Провайдер", data["org"])
        else:
            warn("не удалось определить внешний IP")
    say()
    return st


def show_config() -> None:
    head("Настройки AdGuard VPN")
    cfg = get_config()
    if not cfg:
        warn("не удалось прочитать конфигурацию")
        return
    width = max((len(k) for k in cfg), default=10)
    for key, value in cfg.items():
        kv(key, value or "—", width)
    say()


def show_locations(count: int | None = None, query: str | None = None, favorites_only: bool = False) -> list[dict]:
    rows = get_locations(count)
    if not rows:
        warn("не удалось получить список локаций")
        return []

    state = load_state()
    favs = {f.lower() for f in state.get("favorites", [])}

    if favorites_only:
        rows = [r for r in rows if r["city"].lower() in favs or r["iso"].lower() in favs]
    if query:
        q = query.lower()
        rows = [r for r in rows if q in r["city"].lower() or q in r["country"].lower() or q == r["iso"].lower()]

    head(text("Locations ({count})", "Локации ({count})").format(count=len(rows)))
    print(f"  {C.GREY}{'#':>3}  {'ISO':<4} {text('COUNTRY', 'СТРАНА'):<22} {text('CITY', 'ГОРОД'):<24} {'PING':>5}{C.RESET}")
    for i, r in enumerate(rows, 1):
        star = f"{C.YELLOW}★{C.RESET}" if (r["city"].lower() in favs or r["iso"].lower() in favs) else " "
        ping = r["ping"]
        if ping is None:
            ping_s = f"{C.GREY}  —{C.RESET}"
        elif ping < 60:
            ping_s = f"{C.GREEN}{ping:>4}{C.RESET}"
        elif ping < 120:
            ping_s = f"{C.YELLOW}{ping:>4}{C.RESET}"
        else:
            ping_s = f"{C.RED}{ping:>4}{C.RESET}"
        print(f"  {i:>3}{star} {r['iso']:<4} {r['country'][:22]:<22} {r['city'][:24]:<24} {ping_s} ms")
    say()
    return rows

# --------------------------------------------------------------------------
# действия
# --------------------------------------------------------------------------


def act_connect(location: str | None = None, fastest: bool = False, verbose: bool = False,
                ipv4: bool = False, ipv6: bool = False, yes: bool = True) -> bool:
    args = ["connect"]
    if fastest:
        args.append("-f")
    elif location:
        args += ["-l", location]
    if ipv4:
        args.append("-4")
    if ipv6:
        args.append("-6")
    if yes:
        args.append("-y")
    if verbose:
        args.append("-v")
        return run_live(args) == 0

    target = tr("fastest") if fastest else (location or text("last location", "последняя локация"))
    info(text("connecting: {target}…", "подключаюсь: {target}…").format(target=target))
    success, _ = cli(args, timeout=120)
    if success:
        st = parse_status(status_raw())
        if st["connected"]:
            ok(f"{tr('connected')}: {C.B}{st['location']}{C.RESET} [{st['mode']}]")
            remember(st["location"] or (location or ""))
        for w in st["warnings"]:
            warn(w)
    return success


def act_disconnect() -> bool:
    info("отключаюсь…")
    success, _ = cli(["disconnect"], timeout=60)
    return success


def act_reconnect() -> bool:
    st = parse_status(status_raw())
    location = st["location"] if st["connected"] else None
    if st["connected"]:
        act_disconnect()
        time.sleep(1.5)
    return act_connect(location=location)


def act_toggle() -> bool:
    st = parse_status(status_raw())
    return act_disconnect() if st["connected"] else act_connect()


def act_login() -> bool:
    head("Вход в аккаунт AdGuard")
    return run_live(["login"]) == 0


def act_logout() -> bool:
    return cli(["logout"], timeout=60)[0]


def act_update(check_only: bool = False) -> bool:
    if check_only:
        head("Проверка обновлений")
        return cli(["check-update"], timeout=60)[0]
    head("Обновление AdGuard VPN CLI")
    return run_live(["update", "-v"]) == 0


def act_export_logs(output: str | None = None) -> bool:
    args = ["export-logs", "-f"]
    if output:
        args += ["-o", os.path.expanduser(output)]
    return cli(args, timeout=120)[0]


def act_logs(lines: int = 40, follow: bool = False, tunnel: bool = False) -> None:
    log_file = DATA_DIR / ("tunnel.log" if tunnel else "app.log")
    if not log_file.exists():
        warn(text("log file not found: {path}", "файл лога не найден: {path}").format(path=log_file))
        return
    head(text("Log: {name}", "Лог: {name}").format(name=log_file.name))
    if follow:
        say(f"{C.GREY}Ctrl+C — {tr('quit')}{C.RESET}\n")
        try:
            subprocess.call(["tail", "-n", str(lines), "-f", str(log_file)])
        except KeyboardInterrupt:
            say()
        return
    try:
        content = log_file.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        err(text("could not read log: {error}", "не удалось прочитать лог: {error}").format(error=exc))
        return
    for line in content[-lines:]:
        low = line.lower()
        if "error" in low or "fatal" in low:
            print(f"{C.RED}{line}{C.RESET}")
        elif "warn" in low:
            print(f"{C.YELLOW}{line}{C.RESET}")
        else:
            print(line)
    say()


def act_leak_check() -> None:
    """Проверка: активен ли туннель, куда идут DNS, какой внешний IP."""
    head("Проверка утечек")
    st = parse_status(status_raw())
    if not st["connected"]:
        warn("VPN отключён — весь трафик идёт напрямую")
    else:
        ok(text("tunnel active: {location} [{mode}]", "туннель активен: {location} [{mode}]").format(location=st['location'], mode=st['mode']))

    traffic = iface_traffic(st["iface"])
    if st["iface"]:
        if traffic:
            ok(text("interface {iface} active: ↓ {rx} ↑ {tx}", "интерфейс {iface} живой: ↓ {rx} ↑ {tx}").format(iface=st['iface'], rx=human_bytes(traffic[0]), tx=human_bytes(traffic[1])))
        else:
            warn(text("interface {iface} not found in /sys/class/net", "интерфейс {iface} не найден в /sys/class/net").format(iface=st['iface']))

    sys_dns = system_dns()
    tun_dns = vpn_dns()
    kv("Системный DNS", ", ".join(sys_dns) or "—", 18)
    kv("DNS от VPN", ", ".join(tun_dns) or "—", 18)
    if st["connected"] and tun_dns and sys_dns and not set(tun_dns) & set(sys_dns):
        warn("системный DNS не совпадает с DNS туннеля — возможна утечка DNS")
        say(f"  {C.GREY}{text('fix', 'починить')}: sudo ln -sf {DATA_DIR / 'resolv.conf'} /etc/resolv.conf{C.RESET}")
    elif st["connected"] and set(tun_dns) & set(sys_dns):
        ok("DNS направлен в туннель")

    info("запрашиваю внешний IP…")
    data = external_ip()
    if data:
        place = ", ".join(x for x in (data.get("city"), data.get("country")) if x)
        kv("Внешний IP", f"{data.get('ip', '?')}  {place}", 18)
        if st["connected"] and st["location"] and place:
            city = st["location"].split(",")[0].strip().lower()
            if city and city in place.lower():
                ok("внешний IP соответствует локации VPN")
            else:
                warn("внешний IP не совпадает с городом локации (может быть нормой для некоторых серверов)")
    else:
        warn("не удалось определить внешний IP")
    say()


def act_watch(interval: int = 3) -> None:
    """Живой мониторинг статуса и трафика."""
    st = parse_status(status_raw())
    iface = st["iface"]
    prev = iface_traffic(iface)
    prev_time = time.time()
    say(f"{C.GREY}Ctrl+C — {tr('quit')}{C.RESET}")
    try:
        while True:
            st = parse_status(status_raw())
            if st["iface"] != iface:
                iface = st["iface"]
                prev = iface_traffic(iface)
                prev_time = time.time()
            now = iface_traffic(iface)
            speed = ""
            if prev and now:
                dt = max(time.time() - prev_time, 0.001)
                down = (now[0] - prev[0]) / dt
                up = (now[1] - prev[1]) / dt
                speed = f"  ↓ {human_bytes(down)}/s  ↑ {human_bytes(up)}/s"
            prev, prev_time = now, time.time()

            stamp = datetime.now().strftime("%H:%M:%S")
            if st["connected"]:
                total = f"  {text('total', 'всего')} ↓ {human_bytes(now[0])} ↑ {human_bytes(now[1])}" if now else ""
                line = (f"{C.GREEN}●{C.RESET} {st['location']} [{st['mode']}] "
                        f"{st['iface'] or ''}{speed}{total}")
            else:
                line = f"{C.RED}○{C.RESET} {tr('disconnected')}"
            print(f"\r\033[2K{C.GREY}{stamp}{C.RESET} {line}", end="", flush=True)
            time.sleep(max(interval, 1))
    except KeyboardInterrupt:
        say("\n")

# --------------------------------------------------------------------------
# настройки
# --------------------------------------------------------------------------

BOOL_KEYS = {
    "system-dns": "set-change-system-dns",
    "post-quantum": "set-post-quantum",
    "crash-reports": "set-crash-reporting",
    "telemetry": "set-telemetry",
    "hints": "set-show-hints",
    "debug": "set-debug-logging",
    "notifications": "set-show-notifications",
}


def act_set(key: str, value: str) -> bool:
    """Единая точка установки любой настройки по короткому имени."""
    key = key.lower().replace("_", "-")
    value = value.strip()

    if key in BOOL_KEYS:
        v = value.lower()
        if v in ("on", "true", "1", "yes", "да", "вкл"):
            v = "on"
        elif v in ("off", "false", "0", "no", "нет", "выкл"):
            v = "off"
        else:
            err("значение должно быть on или off")
            return False
        return cli(["config", BOOL_KEYS[key], v])[0]

    if key == "mode":
        v = value.lower()
        if v not in ("tun", "socks"):
            err("режим: tun или socks")
            return False
        return cli(["config", "set-mode", v])[0]

    if key == "dns":
        return cli(["config", "set-dns", value or "default"])[0]

    if key == "socks-port":
        if not value.isdigit() or not (1 <= int(value) <= 65535):
            err("порт: число 1–65535")
            return False
        return cli(["config", "set-socks-port", value])[0]

    if key == "socks-host":
        return cli(["config", "set-socks-host", value])[0]

    if key == "socks-user":
        return cli(["config", "set-socks-username", value])[0]

    if key == "socks-pass":
        return cli(["config", "set-socks-password", value])[0]

    if key == "routing":
        v = value.lower()
        if v not in ("auto", "script", "none"):
            err("маршрутизация: auto, script или none")
            return False
        return cli(["config", "set-tun-routing-mode", v])[0]

    if key == "protocol":
        v = value.lower()
        if v not in ("auto", "http2", "quic"):
            err("протокол: auto, http2 или quic")
            return False
        return cli(["config", "set-protocol", v])[0]

    if key == "channel":
        v = value.lower()
        if v not in ("release", "beta", "nightly"):
            err("канал: release, beta или nightly")
            return False
        return cli(["config", "set-update-channel", v])[0]

    if key in ("interface", "bound-if"):
        return cli(["config", "set-bound-if-override", value])[0]

    err(text("unknown setting: {key}", "неизвестная настройка: {key}").format(key=key))
    say(f"{C.GREY}{text('available', 'доступно')}: mode, dns, socks-port, socks-host, socks-user, socks-pass, "
        f"routing, protocol, channel, interface, {', '.join(BOOL_KEYS)}{C.RESET}")
    return False


def act_socks_clear_auth() -> bool:
    return cli(["config", "clear-socks-auth"])[0]


def act_route_script() -> bool:
    return cli(["config", "create-route-script"], timeout=60)[0]



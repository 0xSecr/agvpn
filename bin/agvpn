EPILOG = f"""
примеры:
  {APP}                        интерактивное меню
  {APP} on                     подключиться (последняя локация)
  {APP} on Riga                подключиться к локации
  {APP} fast                   самая быстрая локация
  {APP} off                    отключиться
  {APP} st                     краткий статус
  {APP} ls -q germ             найти локации по подстроке
  {APP} set dns default        изменить настройку
  {APP} excl add bank.ru       добавить исключение
  {APP} check                  проверка утечек DNS/IP
  {APP} watch                  мониторинг трафика
"""


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=APP,
        description="Удобная оболочка над AdGuard VPN CLI",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("-V", "--version", action="version", version=f"{APP} {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    c = sub.add_parser("connect", aliases=["on", "c"], help="подключиться к VPN")
    c.add_argument("location", nargs="?", help="город, страна или ISO-код")
    c.add_argument("-f", "--fastest", action="store_true", help="самая быстрая локация")
    c.add_argument("-v", "--verbose", action="store_true", help="показать лог сервиса")
    c.add_argument("-4", "--ipv4", action="store_true", help="только IPv4")
    c.add_argument("-6", "--ipv6", action="store_true", help="только IPv6")

    sub.add_parser("disconnect", aliases=["off", "d"], help="отключиться")
    sub.add_parser("fast", aliases=["f"], help="подключиться к самой быстрой локации")
    sub.add_parser("reconnect", aliases=["r"], help="переподключиться")
    sub.add_parser("toggle", aliases=["t"], help="переключить подключение")

    s = sub.add_parser("status", aliases=["st", "s"], help="статус подключения")
    s.add_argument("-i", "--ip", action="store_true", help="показать внешний IP")
    s.add_argument("-b", "--brief", action="store_true", help="одна строка (для панелей)")
    s.add_argument("--json", action="store_true", help="вывод в JSON")

    l = sub.add_parser("locations", aliases=["ls", "l"], help="список локаций")
    l.add_argument("count", nargs="?", type=int, help="сколько показать (по пингу)")
    l.add_argument("-q", "--query", help="фильтр по городу/стране/ISO")
    l.add_argument("--fav", action="store_true", help="только избранные")
    l.add_argument("--json", action="store_true", help="вывод в JSON")

    cfg = sub.add_parser("config", aliases=["cfg"], help="показать настройки")
    cfg.add_argument("--json", action="store_true", help="вывод в JSON")

    setp = sub.add_parser("set", help="изменить настройку")
    setp.add_argument("key", help="mode, dns, socks-port, routing, protocol, channel и др.")
    setp.add_argument("value", nargs="?", default="", help="значение")

    e = sub.add_parser("exclusions", aliases=["excl", "e"], help="исключения сайтов")
    esub = e.add_subparsers(dest="esub")
    ea = esub.add_parser("add", help="добавить домены")
    ea.add_argument("domains", nargs="+")
    ea.add_argument("--for-mode", choices=["general", "selective"])
    er = esub.add_parser("remove", aliases=["rm"], help="удалить домены")
    er.add_argument("domains", nargs="+")
    er.add_argument("--for-mode", choices=["general", "selective"])
    es = esub.add_parser("show", aliases=["ls"], help="показать список")
    es.add_argument("--for-mode", choices=["general", "selective"])
    ec = esub.add_parser("clear", help="очистить список")
    ec.add_argument("--for-mode", choices=["general", "selective"])
    ec.add_argument("-y", "--yes", action="store_true", help="без подтверждения")
    em = esub.add_parser("mode", help="режим general/selective")
    em.add_argument("value", nargs="?", choices=["general", "selective"])

    fav = sub.add_parser("fav", help="избранные локации")
    fsub = fav.add_subparsers(dest="fsub")
    fa = fsub.add_parser("add", help="добавить в избранное")
    fa.add_argument("names", nargs="+")
    fr = fsub.add_parser("remove", aliases=["rm"], help="убрать из избранного")
    fr.add_argument("names", nargs="+")
    fsub.add_parser("list", aliases=["ls"], help="показать избранное")

    prof = sub.add_parser("profile", aliases=["prof"], help="профили настроек")
    psub = prof.add_subparsers(dest="psub")
    ps = psub.add_parser("save", help="сохранить текущие настройки")
    ps.add_argument("name")
    pa = psub.add_parser("apply", help="применить профиль")
    pa.add_argument("name")
    pd = psub.add_parser("delete", aliases=["rm"], help="удалить профиль")
    pd.add_argument("name")
    psub.add_parser("list", aliases=["ls"], help="показать профили")

    sub.add_parser("check", help="проверка утечек DNS/IP")
    sub.add_parser("ip", help="показать внешний IP")

    w = sub.add_parser("watch", aliases=["w"], help="мониторинг трафика")
    w.add_argument("-n", "--interval", type=int, default=3, help="интервал в секундах")

    lg = sub.add_parser("logs", help="показать логи")
    lg.add_argument("-n", "--lines", type=int, default=40, help="сколько строк")
    lg.add_argument("-f", "--follow", action="store_true", help="следить за новыми записями")
    lg.add_argument("-t", "--tunnel", action="store_true", help="лог туннеля вместо app.log")

    ex = sub.add_parser("export-logs", help="экспорт логов в zip")
    ex.add_argument("-o", "--output", help="путь сохранения")

    sub.add_parser("login", help="вход в аккаунт")
    sub.add_parser("logout", help="выход из аккаунта")
    sub.add_parser("license", aliases=["lic"], help="лицензия и аккаунт")

    up = sub.add_parser("update", help="обновить AdGuard VPN CLI")
    up.add_argument("-c", "--check", action="store_true", help="только проверить наличие обновлений")

    sub.add_parser("menu", aliases=["ui"], help="интерактивное меню")

    raw = sub.add_parser("raw", help="передать аргументы напрямую в adguardvpn-cli")
    raw.add_argument("args", nargs=argparse.REMAINDER)

    return p


def dispatch(a: argparse.Namespace) -> int:
    cmd = a.cmd

    if cmd in ("connect", "on", "c"):
        return 0 if act_connect(location=a.location, fastest=a.fastest, verbose=a.verbose,
                                ipv4=a.ipv4, ipv6=a.ipv6) else 1
    if cmd in ("disconnect", "off", "d"):
        return 0 if act_disconnect() else 1
    if cmd in ("fast", "f"):
        return 0 if act_connect(fastest=True) else 1
    if cmd in ("reconnect", "r"):
        return 0 if act_reconnect() else 1
    if cmd in ("toggle", "t"):
        return 0 if act_toggle() else 1

    if cmd in ("status", "st", "s"):
        if a.json:
            st = parse_status(status_raw())
            st["config"] = get_config()
            st["uptime"] = session_uptime()
            traffic = iface_traffic(st["iface"])
            if traffic:
                st["rx_bytes"], st["tx_bytes"] = traffic
            print(json.dumps(st, ensure_ascii=False, indent=2))
            return 0 if st["connected"] else 1
        st = show_status(check_ip=a.ip, brief=a.brief)
        return 0 if st["connected"] else 1

    if cmd in ("locations", "ls", "l"):
        if a.json:
            print(json.dumps(get_locations(a.count), ensure_ascii=False, indent=2))
            return 0
        show_locations(count=a.count, query=a.query, favorites_only=a.fav)
        return 0

    if cmd in ("config", "cfg"):
        if a.json:
            print(json.dumps(get_config(), ensure_ascii=False, indent=2))
        else:
            show_config()
        return 0

    if cmd == "set":
        return 0 if act_set(a.key, a.value) else 1

    if cmd in ("exclusions", "excl", "e"):
        mode = getattr(a, "for_mode", None)
        if a.esub == "add":
            return 0 if act_excl_add(a.domains, mode) else 1
        if a.esub in ("remove", "rm"):
            return 0 if act_excl_remove(a.domains, mode) else 1
        if a.esub == "clear":
            return 0 if act_excl_clear(mode, a.yes) else 1
        if a.esub == "mode":
            return 0 if act_excl_mode(a.value) else 1
        act_excl_show(mode)
        return 0

    if cmd == "fav":
        if a.fsub == "add":
            act_fav_add(a.names)
        elif a.fsub in ("remove", "rm"):
            act_fav_remove(a.names)
        else:
            act_fav_list()
        return 0

    if cmd in ("profile", "prof"):
        if a.psub == "save":
            act_profile_save(a.name)
        elif a.psub == "apply":
            return 0 if act_profile_apply(a.name) else 1
        elif a.psub in ("delete", "rm"):
            act_profile_delete(a.name)
        else:
            act_profile_list()
        return 0

    if cmd == "check":
        act_leak_check()
        return 0

    if cmd == "ip":
        data = external_ip()
        if not data:
            err("не удалось определить внешний IP")
            return 1
        place = ", ".join(x for x in (data.get("city"), data.get("country")) if x)
        say(f"{C.B}{data.get('ip')}{C.RESET}" + (f"  {C.GREY}{place}{C.RESET}" if place else ""))
        if data.get("org"):
            say(f"{C.GREY}{data['org']}{C.RESET}")
        return 0

    if cmd in ("watch", "w"):
        act_watch(a.interval)
        return 0

    if cmd == "logs":
        act_logs(a.lines, a.follow, a.tunnel)
        return 0

    if cmd == "export-logs":
        return 0 if act_export_logs(a.output) else 1

    if cmd == "login":
        return 0 if act_login() else 1
    if cmd == "logout":
        return 0 if act_logout() else 1
    if cmd in ("license", "lic"):
        head("Лицензия и аккаунт")
        say(license_info())
        say()
        return 0

    if cmd == "update":
        return 0 if act_update(check_only=a.check) else 1

    if cmd in ("menu", "ui"):
        main_menu()
        return 0

    if cmd == "raw":
        args = [x for x in (a.args or []) if x != "--"]
        if not args:
            err("нечего передавать")
            return 2
        return run_live(args)

    return 2


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not have_cli():
        err(f"adguardvpn-cli не найден в PATH (искал: {BIN})")
        say("Установка:")
        say("  curl -fsSL https://raw.githubusercontent.com/AdguardTeam/AdguardVPNCLI/HEAD/scripts/release/install.sh | sh -s -- -v")
        return 127

    if not argv:
        try:
            main_menu()
        except KeyboardInterrupt:
            say("\nПрервано.")
            return 130
        return 0

    # raw обрабатываем до argparse, иначе он перехватывает флаги вроде --version
    if argv[0] == "raw":
        rest = [x for x in argv[1:] if x != "--"]
        if not rest:
            err("нечего передавать")
            return 2
        return run_live(rest)

    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_help()
        return 0
    try:
        return dispatch(args)
    except KeyboardInterrupt:
        say("\nПрервано.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
